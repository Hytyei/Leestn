+files.set("one.mp3", { bytes: mp3(CH * 10), type: "audio/mpeg" });
+let n = 0;
+setAi(() => { n++; if (n === 3) throw new Error("AiError: bad audio"); return { segments: [{ start: 0, end: 2, text: " Hallo." }] }; });
+let r = await call(env, "POST", "/v1/transcripts", T, { epId: "one", audioUrl: "https://cdn.example.com/one.mp3", durationSec: 100 });
+ok("request accepted", r.s === 202);
+await run([2]);
+r = await call(env, "GET", "/v1/transcripts/one", T);
+ok("episode with one bad slice is still ready", r.j.status === "ready" && r.j.lines.length === 9, r.j);
+ok("it says a part is missing", /1 short part/.test(r.j.error ?? ""), r.j);
+
+// every slice rejected: failed, and the message names the real error
+files.set("bad.mp3", { bytes: mp3(CH * 8), type: "audio/mpeg" });
+setAi(() => { throw new Error("AiError: model overloaded"); });
+await call(env, "POST", "/v1/transcripts", T, { epId: "bad", audioUrl: "https://cdn.example.com/bad.mp3", durationSec: 80 });
+await run([0, 1, 2, 3, 4, 5, 6, 7]);
+r = await call(env, "GET", "/v1/transcripts/bad", T);
+ok("all slices failing fails the episode with the reason", r.j.status === "failed" && /model overloaded/.test(r.j.error), r.j);
+
+// retries below the limit do not skip anything
+files.set("retry.mp3", { bytes: mp3(CH * 2), type: "audio/mpeg" });
+setAi(() => ({ segments: [{ start: 0, end: 1, text: " Hi." }] }));
+await call(env, "POST", "/v1/transcripts", T, { epId: "retry", audioUrl: "https://cdn.example.com/retry.mp3", durationSec: 20 });
+await run([]);
+r = await call(env, "GET", "/v1/transcripts/retry", T);
+ok("normal episode unchanged", r.j.status === "ready" && !r.j.error, r.j);
+
+// host answers 403: a clear message that names the host
+r = await call(env, "POST", "/v1/transcripts", T, { epId: "gone", audioUrl: "https://cdn.example.com/missing.mp3", durationSec: 20 });
+ok("missing/blocked audio gives a readable error", r.s === 422 && /cdn\.example\.com/.test(JSON.stringify(r.j)) && /HTTP 404/.test(JSON.stringify(r.j)), r.j);
+finish();
diff --git a/backend/test/timing.ts b/backend/test/timing.ts
new file mode 100644
index 0000000..4d2e73d
--- /dev/null
+++ b/backend/test/timing.ts
@@ -0,0 +1,72 @@
+// Shared timing fixes: migration 0004 on top of the current schema, the PUT/GET API, and reset on regeneration.
+import { call, drain, files, finish, makeDb, makeEnv, ok } from "./harness";
+
+// --- upgrade from the current production schema (0001..0003) with an existing finished transcript ---
+const { db, DB } = makeDb("0003_usage_meter.sql");
+const now = Date.now();
+db.exec(`INSERT INTO transcripts (ep_id,status,progress,error,chunks_total,audio_url,duration_sec,lines,requested_by,created_at,updated_at,audio_sec)
+         VALUES ('old1','ready',1,NULL,3,'https://cdn.example.com/x.mp3',1800,'[{"t":0,"text":"a"},{"t":60,"text":"b"}]','u1',${now},${now},1800)`);
+const env = makeEnv(DB);
+env.WHISPER_DAILY_MINUTES = "100000"; env.MAX_PER_USER_PER_DAY = "50"; env.MAX_TRANSCRIPTS_PER_DAY = "50";
+const A = (await call(env, "POST", "/v1/users", "secret", { handle: "ann", name: "A" })).j.token;
+const B = (await call(env, "POST", "/v1/users", "secret", { handle: "bob", name: "B" })).j.token;
+
+// the new Worker must keep serving transcripts even before the migration has run
+let r = await call(env, "GET", "/v1/transcripts/old1", A);
+ok("reading works before migration 0004 is applied", r.s === 200 && r.j.status === "ready" && r.j.lines.length === 2 && r.j.timing === undefined, r);
+
+db.exec(await Bun.file(import.meta.dir + "/../migrations/0004_transcript_timing.sql").text());
+ok("old transcript survives the migration", (db.prepare("SELECT COUNT(*) n FROM transcripts WHERE ep_id='old1'").get() as any).n === 1);
+db.exec(await Bun.file(import.meta.dir + "/../migrations/0004_transcript_timing.sql").text());
+ok("0004 can be run twice without error (idempotent)", true);
+
+r = await call(env, "GET", "/v1/transcripts/old1", A);
+ok("no fix saved yet: no timing field", r.s === 200 && r.j.timing === undefined, r);
+
+// --- save a fix as Ann, see it as Bob ---
+ok("saving needs an account", (await call(env, "PUT", "/v1/transcripts/old1/timing", "", { offset: 3 })).s === 401);
+r = await call(env, "PUT", "/v1/transcripts/old1/timing", A, { offset: 4, anchors: [[0, 2], [1, 70]] });
+ok("Ann saves a fix", r.s === 200 && r.j.timing.offset === 4, r);
+r = await call(env, "GET", "/v1/transcripts/old1", B);
+ok("Bob sees Ann's fix", r.j.timing && r.j.timing.offset === 4 && r.j.timing.anchors.length === 2 && r.j.timing.anchors[1][1] === 70, r.j);
+r = await call(env, "PUT", "/v1/transcripts/old1/timing", B, { offset: -2, anchors: [[5, 9]] });
+r = await call(env, "GET", "/v1/transcripts/old1", A);
+ok("last save wins", r.j.timing.offset === -2 && r.j.timing.anchors.length === 1, r.j);
+r = await call(env, "POST", "/v1/transcripts", A, { epId: "old1", audioUrl: "https://cdn.example.com/x.mp3", durationSec: 1800 });
+ok("asking for a finished transcript also returns the fix", r.s === 200 && r.j.timing?.offset === -2, r);
+
+// --- validation ---
+r = await call(env, "PUT", "/v1/transcripts/old1/timing", A, { offset: 99999, anchors: [["x", 1], [1], [-1, 5], [2, 999999], [3, 30], "nope"] });
+ok("junk is clamped or dropped", r.s === 200 && r.j.timing.offset === 3600 && JSON.stringify(r.j.timing.anchors) === "[[3,30]]" && r.j.timing.shifts.length === 0, r);
+ok("no transcript, no fix", (await call(env, "PUT", "/v1/transcripts/nothing/timing", A, { offset: 1 })).s === 404);
+
+// --- per-line shifts, negative anchor targets, and rows saved by the previous release (plain anchor array) ---
+r = await call(env, "PUT", "/v1/transcripts/old1/timing", A, { offset: 0, anchors: [[1, -30]], shifts: [[1, 1, 5], [2, -1, -3], [0, 0, 0], [4], ["x", 1, 1], [3, -5, 1]] });
+ok("shifts are saved, junk shifts dropped, a small negative target is allowed", r.s === 200 && JSON.stringify(r.j.timing.shifts) === "[[1,1,5],[2,-1,-3]]" && r.j.timing.anchors[0][1] === -30, r);
+r = await call(env, "GET", "/v1/transcripts/old1", B);
+ok("Bob sees the shifts", r.j.timing?.shifts?.length === 2, r.j);
+db.exec(`UPDATE transcript_edits SET anchors='[[0,2],[1,70]]', offset_sec=4 WHERE ep_id='old1'`);
+r = await call(env, "GET", "/v1/transcripts/old1", B);
+ok("a row written by the previous release still reads", r.j.timing.offset === 4 && r.j.timing.anchors.length === 2 && r.j.timing.shifts.length === 0, r.j);
+r = await call(env, "PUT", "/v1/transcripts/old1/timing", A, { offset: 0, anchors: [], shifts: [[2, 2, 4]] });
+r = await call(env, "PUT", "/v1/transcripts/old1/timing", A, { offset: 0, anchors: [], shifts: [[0, -1, 1500], [1, 1, -250], [2, 2, 99_999_999]] });
+ok("shifts are milliseconds; absurd ones are dropped", JSON.stringify(r.j.timing.shifts) === "[[0,-1,1500],[1,1,-250]]", r);
+r = await call(env, "PUT", "/v1/transcripts/old1/timing", A, { offset: 0, anchors: [], shifts: [[2, 2, 4]] });
+ok("only a shift is enough to be saved", r.s === 200 && r.j.timing?.shifts?.length === 1, r);
+
+// --- clearing ---
+r = await call(env, "PUT", "/v1/transcripts/old1/timing", A, { offset: 0, anchors: [] });
+ok("saving an empty fix clears it", r.s === 200 && r.j.timing === null, r);
+r = await call(env, "GET", "/v1/transcripts/old1", B);
+ok("and it is gone for everyone", r.j.timing === undefined, r.j);
+
+// --- a new transcription drops the old fix, because the lines are different ---
+files.set("n.mp3", { bytes: new Uint8Array(70_000).fill(1), type: "audio/mpeg" });
+await call(env, "POST", "/v1/transcripts", A, { epId: "n", audioUrl: "https://cdn.example.com/n.mp3", durationSec: 30 });
+await drain(env);
+await call(env, "PUT", "/v1/transcripts/n/timing", A, { offset: 7, anchors: [[0, 3]] });
+r = await call(env, "GET", "/v1/transcripts/n", A);
+ok("fix saved on a generated transcript", r.j.timing?.offset === 7, r.j);
+await call(env, "POST", "/v1/transcripts", A, { epId: "n", audioUrl: "https://cdn.example.com/n.mp3", durationSec: 30, force: true });
+ok("redo clears the old fix", (db.prepare("SELECT COUNT(*) n FROM transcript_edits WHERE ep_id='n'").get() as any).n === 0);
+finish();
diff --git a/backend/test/usage.ts b/backend/test/usage.ts
new file mode 100644
index 0000000..4091bab
--- /dev/null
+++ b/backend/test/usage.ts
@@ -0,0 +1,47 @@
+// Tests for the free-Whisper-allowance meter (migration 0003, GET /v1/usage, the 429 guard).
+import { call, drain, files, finish, makeDb, makeEnv, ok, queued } from "./harness";
+
+// --- upgrade: a database at the CURRENT production schema (0001+0002) with real-looking data ---
+const { db, DB } = makeDb("0002_social_ratings.sql");
+const now = Date.now();
+db.exec(`INSERT INTO transcripts (ep_id,status,progress,error,chunks_total,audio_url,duration_sec,lines,requested_by,created_at,updated_at)
+         VALUES ('old1','ready',1,NULL,3,'https://cdn.example.com/x.mp3',1800,'[]','u1',${now},${now})`);
+const migration = await Bun.file(import.meta.dir + "/../migrations/0003_usage_meter.sql").text();
+db.exec(migration);
+const kept: any = db.prepare("SELECT ep_id,status,audio_sec,duration_sec FROM transcripts WHERE ep_id='old1'").get();
+ok("existing rows survive the migration", kept && kept.status === "ready" && kept.duration_sec === 1800);
+ok("old rows get audio_sec 0", kept.audio_sec === 0);
+let again = true; try { db.exec(migration); } catch { again = false; }
+ok("running 0003 twice is rejected by SQLite, so the release script must only run pending migrations", again === false);
+
+// --- endpoint and guard, small allowance so the test is quick ---
+const env = makeEnv(DB);
+env.WHISPER_DAILY_MINUTES = "10";
+const u = await call(env, "POST", "/v1/users", "secret", { handle: "meter", name: "M" });
+const T = u.j.token;
+let r = await call(env, "GET", "/v1/usage", T);
+ok("usage requires auth", (await call(env, "GET", "/v1/usage")).s === 401);
+ok("usage shows the limit and nothing used", r.s === 200 && r.j.limitMin === 10 && r.j.usedMin === 0 && r.j.remainingMin === 10);
+ok("usage says it is an estimate", r.j.estimate === true && r.j.resetsAt > Date.now());
+
+files.set("a.mp3", { bytes: new Uint8Array(200_000).fill(1), type: "audio/mpeg" });
+files.set("b.mp3", { bytes: new Uint8Array(200_000).fill(2), type: "audio/mpeg" });
+r = await call(env, "POST", "/v1/transcripts", T, { epId: "e1", audioUrl: "https://cdn.example.com/a.mp3", durationSec: 360 });
+ok("6 min episode accepted", r.s === 202);
+r = await call(env, "GET", "/v1/usage", T);
+ok("meter counts 6 of 10", r.j.usedMin === 6 && r.j.remainingMin === 4);
+const before = queued.length;
+r = await call(env, "POST", "/v1/transcripts", T, { epId: "e2", audioUrl: "https://cdn.example.com/b.mp3", durationSec: 300 });
+ok("5 more minutes is refused with 429 and a clear message", r.s === 429 && /free Whisper time/.test(r.j.error ?? r.j.message ?? JSON.stringify(r.j)));
+ok("refused request queues nothing and stores nothing", queued.length === before && (db.prepare("SELECT COUNT(*) n FROM transcripts WHERE ep_id='e2'").get() as any).n === 0);
+r = await call(env, "POST", "/v1/transcripts", T, { epId: "e3", audioUrl: "https://cdn.example.com/b.mp3", durationSec: 200 });
+ok("a shorter one that still fits is accepted", r.s === 202);
+// unknown duration falls back to size at 128 kbps (200 kB is about 12 s)
+r = await call(env, "GET", "/v1/usage", T);
+ok("meter now 9.3", r.j.usedMin === 9.3);
+await drain(env);
+r = await call(env, "GET", "/v1/usage", T);
+ok("finishing jobs does not change the meter", r.j.usedMin === 9.3);
+// old rows (audio_sec 0, created today) do not break the sum
+ok("old row does not count", true);
+finish();
